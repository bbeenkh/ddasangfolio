{
  "name": "ddsf",
  "description": "따상폴리오",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "local": "turbo run local",
    "local:a": "pnpm --filter ddsf-mobile local:a",
    "local:i": "pnpm --filter ddsf-mobile local:i",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.15",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
